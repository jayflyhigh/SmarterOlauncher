<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/widgetCircle"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:background="@drawable/bg_home_widget_circle"
        android:elevation="8dp"
        android:focusable="true"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/widgetTime"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/widgetTimeValue"
                style="@style/QuickTileText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:format12Hour="hh:mm"
                android:format24Hour="HH:mm"
                android:textSize="28sp"
                tools:text="08:05" />

            <TextClock
                android:id="@+id/widgetAmPm"
                style="@style/QuickTileText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:format12Hour="a"
                android:format24Hour=""
                android:textSize="14sp"
                tools:text="AM" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widgetBattery"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/widgetBatteryIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_battery_widget"
                app:tint="?attr/primaryColor" />

            <TextView
                android:id="@+id/widgetBatteryPercent"
                style="@style/QuickTileText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="32sp"
                tools:text="85%" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widgetDate"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextClock
                android:id="@+id/widgetDay"
                style="@style/QuickTileText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:format12Hour="EEE"
                android:format24Hour="EEE"
                android:textSize="28sp"
                tools:text="Mon" />

            <TextClock
                android:id="@+id/widgetDateValue"
                style="@style/QuickTileText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:format12Hour="dd MMM"
                android:format24Hour="dd MMM"
                android:textSize="16sp"
                tools:text="05 Jan" />
        </LinearLayout>
    </FrameLayout>

    <View
        android:id="@+id/widgetChargingGlow"
        android:layout_width="136dp"
        android:layout_height="136dp"
        android:elevation="9dp"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <View
        android:id="@+id/widgetResizeOutside"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="10dp"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widgetResizePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="12dp"
        android:background="@drawable/bg_quick_panel"
        android:elevation="11dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        android:visibility="gone">

        <SeekBar
            android:id="@+id/widgetSizeSlider"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:contentDescription="@string/widget_circle_size"
            android:max="224"
            android:progress="56"
            android:progressTint="?attr/primaryColor"
            android:thumbTint="?attr/primaryColor" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/widgetResizeColor"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_quick_bar"
            android:contentDescription="@string/widget_circle_color"
            android:padding="12dp"
            app:srcCompat="@drawable/ic_color_wheel" />
    </LinearLayout>
</FrameLayout>
