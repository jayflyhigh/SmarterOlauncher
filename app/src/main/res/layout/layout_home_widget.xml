<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/homeWidgetPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_quick_panel"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="11dp">

        <TextView
            android:id="@+id/widgetCommandSearch"
            style="@style/QuickBarText"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_margin="5dp"
            android:background="@drawable/bg_quick_bar"
            android:focusable="true"
            android:text="@string/widget_command_search" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/widgetCircle"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:background="@drawable/bg_home_widget_circle"
        android:elevation="8dp"
        android:focusable="true"
        android:padding="12dp">

        <TextClock
            android:id="@+id/widgetTime"
            style="@style/QuickTileText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:format12Hour="hh:mm\na"
            android:format24Hour="HH:mm"
            android:textSize="20sp"
            tools:text="08:05\nAM" />

        <LinearLayout
            android:id="@+id/widgetBattery"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/widgetBatteryIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_battery_widget"
                app:tint="?attr/primaryColor" />

            <TextView
                android:id="@+id/widgetBatteryPercent"
                style="@style/QuickTileText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                tools:text="85%" />
        </LinearLayout>

        <TextClock
            android:id="@+id/widgetDate"
            style="@style/QuickTileText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:format12Hour="EEE\ndd MMM"
            android:format24Hour="EEE\ndd MMM"
            android:textSize="18sp"
            android:visibility="gone"
            tools:text="Mon\n05 Jan" />
    </FrameLayout>
</FrameLayout>
