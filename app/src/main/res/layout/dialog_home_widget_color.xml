<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="144dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/wheelHost"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <FrameLayout
                android:id="@+id/circlePreview"
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <include
            android:id="@+id/colorPicker"
            layout="@layout/view_app_search_color_picker" />

        <TextView
            android:id="@+id/transparencyValue"
            style="@style/AppSearchColorChannel"
            android:labelFor="@id/transparency" />

        <SeekBar
            android:id="@+id/transparency"
            style="@style/AppSearchColorSlider"
            android:max="100"
            android:contentDescription="@string/widget_circle_transparency" />
    </LinearLayout>
</ScrollView>
