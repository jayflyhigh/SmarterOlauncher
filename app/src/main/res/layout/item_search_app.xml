<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginVertical="4dp"
    android:minHeight="64dp"
    android:background="@drawable/bg_search_tile"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="4dp"
    android:paddingVertical="8dp">

    <ImageView
        android:id="@+id/itemIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="20dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        tools:src="@mipmap/ic_launcher" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/itemTitle"
            style="@style/SearchTileTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="Chrome" />
        <TextView
            android:id="@+id/itemType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/search_type_app"
            android:textColor="@color/search_secondary"
            android:textSize="13sp"
            android:includeFontPadding="false" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/contactActions"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/contactCallAction"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_search_button"
            android:contentDescription="@string/call"
            android:padding="11dp"
            android:src="@drawable/ic_call"
            android:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/contactTextAction"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_search_button"
            android:contentDescription="@string/text_message"
            android:padding="11dp"
            android:src="@drawable/ic_message"
            android:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/contactWhatsAppAction"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_search_button"
            android:contentDescription="@string/whatsapp"
            android:padding="11dp"
            android:src="@drawable/ic_whatsapp"
            android:tint="@android:color/white" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/itemMenu"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_search_button"
        android:padding="14dp"
        android:src="@drawable/ic_search_more"
        android:tint="@color/search_secondary"
        android:contentDescription="@string/search_page_menu" />

    <androidx.appcompat.widget.AppCompatCheckBox
        android:id="@+id/massUninstallCheck"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:buttonTint="@color/search_accent"
        android:contentDescription="@string/mass_uninstall_select"
        android:visibility="gone" />
</LinearLayout>
